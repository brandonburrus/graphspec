{
  "name": "graph-spec-cli",
  "version": "0.2.0",
  "description": "GraphSpec: a CLI + library for spec-driven development: author software specs as an OKF knowledge graph and build software by traversing it.",
  "type": "module",
  "license": "MIT",
  "author": "brandonburrus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonburrus/graphspec.git"
  },
  "homepage": "https://github.com/brandonburrus/graphspec#readme",
  "bugs": {
    "url": "https://github.com/brandonburrus/graphspec/issues"
  },
  "keywords": ["spec-driven-development", "okf", "knowledge-graph", "cli", "ai-agents"],
  "bin": {
    "graphspec": "dist/cli.js"
  },
  "files": ["dist", "src", "skills", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^12.1.0",
    "figlet": "^1.11.4",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
